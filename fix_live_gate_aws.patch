+    def _resolve_actual_dry_run(self, dry_run: bool) -> bool:
+        """Resolve whether an order executes as dry-run.
+
+        On AWS the caller's ``dry_run`` (derived from ``get_live_trading(db)``) is
+        authoritative — see ``_refresh_runtime_flags`` docstring. The previous
+        ``dry_run or not self.live_trading`` forced every AWS order to dry because
+        ``self.live_trading`` is pinned False on AWS, so automated orders never
+        executed real. The live-trading mutation gate remains the second barrier on
+        the non-dry path.
+        """
+        try:
+            from app.core.runtime import is_aws_runtime
+            if is_aws_runtime():
+                return bool(dry_run)
+        except Exception:
+            pass
+        return bool(dry_run) or not self.live_trading
