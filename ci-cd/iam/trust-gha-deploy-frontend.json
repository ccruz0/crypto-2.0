{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Principal": {
        "Federated": "arn:aws:iam::634531197711:oidc-provider/token.actions.githubusercontent.com"
      },
      "Action": "sts:AssumeRoleWithWebIdentity",
      "Condition": {
        "StringEquals": {
          "token.actions.githubusercontent.com:aud": "sts.amazonaws.com"
        },
        "ForAnyValue:StringLike": {
          "token.actions.githubusercontent.com:sub": [
            "repo:ccruz0/crypto-2.0:ref:refs/heads/main",
            "repo:ccruz0/crypto-2.0:environment:production"
          ]
        }
      }
    }
  ]
}
